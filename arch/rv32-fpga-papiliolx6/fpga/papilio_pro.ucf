# Pin assignment of the Papilio Pro (Spartan-6 XC6SLX9-TQG144).
# Source: the Gadget Factory BPC3010_Papilio_Pro schematic and
#       Overview of the Papilio Pro (a saved copy of the Papilio wiki). The SDRAM is a Micron MT48LC4M16 (64Mbit, 4M x 16 x 4 banks).
#       The FPGA pin numbers were read from an enlarged schematic (2026-11-16); confirmed on the board.

NET clk32   LOC = P94  | IOSTANDARD = LVCMOS33;     # 32MHz oscillator
NET clk32   TNM_NET = clk32;
TIMESPEC TS_clk32 = PERIOD clk32 31.25 ns HIGH 50%;

# FT2232 channel A (UART). As seen from the FPGA, RX = input, TX = output
NET uart_rx LOC = P101 | IOSTANDARD = LVCMOS33;
NET uart_tx LOC = P105 | IOSTANDARD = LVCMOS33;

NET led     LOC = P112 | IOSTANDARD = LVCMOS33;     # LED1

# SDRAM
NET sd_clk  LOC = P32  | IOSTANDARD = LVCMOS33;
NET sd_cke  LOC = P33  | IOSTANDARD = LVCMOS33;
NET sd_cs_n LOC = P1   | IOSTANDARD = LVCMOS33;
NET sd_ras_n LOC = P2  | IOSTANDARD = LVCMOS33;
NET sd_cas_n LOC = P5  | IOSTANDARD = LVCMOS33;
NET sd_we_n LOC = P6   | IOSTANDARD = LVCMOS33;
NET sd_dqm<0> LOC = P7  | IOSTANDARD = LVCMOS33;
NET sd_dqm<1> LOC = P17 | IOSTANDARD = LVCMOS33;
NET sd_ba<0> LOC = P143 | IOSTANDARD = LVCMOS33;
NET sd_ba<1> LOC = P142 | IOSTANDARD = LVCMOS33;
NET sd_a<0>  LOC = P140 | IOSTANDARD = LVCMOS33;
NET sd_a<1>  LOC = P139 | IOSTANDARD = LVCMOS33;
NET sd_a<2>  LOC = P138 | IOSTANDARD = LVCMOS33;
NET sd_a<3>  LOC = P137 | IOSTANDARD = LVCMOS33;
NET sd_a<4>  LOC = P46  | IOSTANDARD = LVCMOS33;
NET sd_a<5>  LOC = P45  | IOSTANDARD = LVCMOS33;
NET sd_a<6>  LOC = P44  | IOSTANDARD = LVCMOS33;
NET sd_a<7>  LOC = P43  | IOSTANDARD = LVCMOS33;
NET sd_a<8>  LOC = P41  | IOSTANDARD = LVCMOS33;
NET sd_a<9>  LOC = P40  | IOSTANDARD = LVCMOS33;
NET sd_a<10> LOC = P141 | IOSTANDARD = LVCMOS33;
NET sd_a<11> LOC = P35  | IOSTANDARD = LVCMOS33;
NET sd_a<12> LOC = P34  | IOSTANDARD = LVCMOS33;    # NC on the MT48LC4M16 (the schematic connects it to A12)
NET sd_dq<0>  LOC = P9  | IOSTANDARD = LVCMOS33;
NET sd_dq<1>  LOC = P10 | IOSTANDARD = LVCMOS33;
NET sd_dq<2>  LOC = P11 | IOSTANDARD = LVCMOS33;
NET sd_dq<3>  LOC = P12 | IOSTANDARD = LVCMOS33;
NET sd_dq<4>  LOC = P14 | IOSTANDARD = LVCMOS33;
NET sd_dq<5>  LOC = P15 | IOSTANDARD = LVCMOS33;
NET sd_dq<6>  LOC = P16 | IOSTANDARD = LVCMOS33;
NET sd_dq<7>  LOC = P8  | IOSTANDARD = LVCMOS33;
NET sd_dq<8>  LOC = P21 | IOSTANDARD = LVCMOS33;
NET sd_dq<9>  LOC = P22 | IOSTANDARD = LVCMOS33;
NET sd_dq<10> LOC = P23 | IOSTANDARD = LVCMOS33;
NET sd_dq<11> LOC = P24 | IOSTANDARD = LVCMOS33;
NET sd_dq<12> LOC = P26 | IOSTANDARD = LVCMOS33;
NET sd_dq<13> LOC = P27 | IOSTANDARD = LVCMOS33;
NET sd_dq<14> LOC = P29 | IOSTANDARD = LVCMOS33;
NET sd_dq<15> LOC = P30 | IOSTANDARD = LVCMOS33;
