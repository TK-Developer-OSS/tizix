# Makefile.tz - build the kernel with some objects compiled by tzcc (--march=ia16) instead of ia16-gcc.
#   make -f Makefile.tz OBJ=obj/tz IMG=disk/floppy_tz.img
# The existing Makefile is included untouched; only the objects listed in TZ_OBJS are replaced.
# Commands use the resident DRIVER (/bin/driver.bin, tz/drv16.c + tz/drv16e.S) for stdio and the string functions,
# as DRIVER.BIN on the z80: they link user/drvc.S (a stub per DRIVER function, user/drvtab.h) instead of ulibc.o +
# libc.o, which every command used to carry whole. Set before the include: the Makefile then leaves the link to us.
UCMD_DRV = 1
include Makefile

TZCC = ../../tzcc/tzcc
# Every C file of the kernel is compiled by tzcc; ia16-gcc is only the preprocessor, as and ld remain.
TZ_OBJS = kmain console init kernel builtin kexec io pipe sysfile
# The file system is the shared FatFs stack of the gcc kernel (ff, fsbackend_fat, fatcmd, vfs, dev, dev_fda, diskio, libc,
# libgcc: ia16-gcc objects), reached through tz/fsif.c and the stack-switching trampolines of glue.S. Nothing is dropped.
TZ_DROP =
KOBJ := $(filter-out $(addprefix $(OBJ)/,$(addsuffix .o,$(TZ_DROP))),$(KOBJ)) $(OBJ)/fsif.o
$(OBJ)/fsif.o: tz/fsif.c | $(OBJ)
	$(CC) $(CFLAGS) -c -o $@ $<

# Minimal configuration: fewer process slots, so that the per-slot syscall stacks (1KB each, in the kernel's 64KB
# segment) leave room for the tzcc code. TZ_MAXSLOT=24 is the gcc kernel's number.
TZ_MAXSLOT ?= 24
X86_MAXSLOT := $(TZ_MAXSLOT)
CFLAGS += -DX86_MAXSLOT=$(TZ_MAXSLOT)

# kwork[] size and the kw.h offsets are derived from plat.h / kmem.h so that they cannot drift from the gcc side.
N := $(X86_MAXSLOT)
# Same formula as X86_KWORK_SIZE in src/kmem.h (tz/check.sh verifies that both agree).
KWORK_SIZE := $(shell echo $$(( 8*$(N) + 0x10A + 0x10 + 120*$(N) + 96 )))
# MEMCAP_KB=N: report at most N KB of conventional memory (software memory limit for QEMU, which cannot go below 640KB).
MEMCAP_KB ?= 0
# Layout: the kernel at KSEG:0 = physical 0x1000 (a 4KB block boundary), its stack in segment 0 just below it
# (physical 0x600..KSTK_TOP, above the BIOS data and boot info), the pool from the next 4KB block after bss.
# stage2 first moves itself to the last 4KB (S2_RELOC): the kernel is loaded over stage1/stage2's original place.
TZ_KSEG ?= 0x0100
KSTK_TOP ?= 0x1000
CFLAGS += -Wa,--defsym,KSEG_DEF=$(TZ_KSEG) -Wa,--defsym,KSTK_LOW=1 -Wa,--defsym,S2_RELOC=1 -Wa,--defsym,S2_MEMCAP=$(MEMCAP_KB)
# SC_PSTACK=1: syscalls run on the caller's stack (crt0.s _isr80), no syscall stack per slot. 0 = the gcc kernel's way.
SC_PSTACK ?= 1
ifeq ($(SC_PSTACK),1)
CFLAGS += -Wa,--defsym,SC_PSTACK=1
endif
define KW_H
/* generated by Makefile.tz: offsets inside kwork[] (src/kmem.h, x86-ia16 section) */
#define KW_CUR_O   $(shell echo $$((3*$(N))))
#define KW_EPOCH_O $(shell echo $$((4*$(N)+0x102)))
#define KW_SUB_O   $(shell echo $$((4*$(N)+0x106)))
#define KW_TICKS_O $(shell echo $$((4*$(N)+0x107)))
#define KW_BLK_O   $(shell echo $$((4*$(N)+0x109)))
#define KW_WAKE_O  $(shell echo $$((5*$(N)+0x109)))
#define KW_SP_O    $(N)
#define KW_SS_O    $(shell echo $$((6*$(N)+0x10A)))
#define MAXSLOT    $(N)
#define KW_OUT_O   $(shell echo $$((3*$(N)+0x102)))
#define SCSTK      $(shell echo $$((1<<$(X86_SCSTK_SHIFT))))
#define PROC_BLOCK_MAX $(shell echo $$(($(N)-1)))
#define TICK_HZ $(shell sed -n 's/^\#define TICK_HZ *\([0-9][0-9]*\).*/\1/p' $(SRC)/kernel.h)
#define MEMCAP_KB $(MEMCAP_KB)
#define KSEG_DEF $(TZ_KSEG)
#define SC_PSTACK $(SC_PSTACK)
endef
# Written while the makefile is read, and only when the content changed, so that its mtime is already settled
# (and the objects that include it rebuild) before any rule is evaluated.
KW_H_DONE := $(shell mkdir -p $(OBJ))$(file >$(OBJ)/kw.h.new,$(KW_H))$(shell cmp -s $(OBJ)/kw.h.new $(OBJ)/kw.h || mv $(OBJ)/kw.h.new $(OBJ)/kw.h; rm -f $(OBJ)/kw.h.new)
$(OBJ)/kw.h: ;
# make does not track CFLAGS: crt0 (KSEG) and stage2 (KSEG, S2_MEMCAP) rebuild when kw.h changes
$(OBJ)/crt0.o $(OBJ)/stage2.bin: $(OBJ)/kw.h
$(OBJ)/glue_tz.o: tz/glue.S $(OBJ)/kw.h | $(OBJ)
	$(CC) -x assembler-with-cpp -I$(OBJ) -include $(OBJ)/kw.h -Wa,--defsym,KWORK_SIZE=$(KWORK_SIZE) -c -o $@ $<

# C -> (ia16-gcc preprocessor only) -> tzcc -> as.  tzcc has no preprocessor.
$(OBJ)/%.tz.i: tz/%.c $(HDRS) $(OBJ)/kw.h | $(OBJ)
	$(CC) -E -P -I$(OBJ) $(filter-out -O2 -Wall -Wextra,$(CFLAGS)) -o $@ $<
$(OBJ)/%.tz.s: $(OBJ)/%.tz.i $(TZCC)
	$(TZCC) --march=ia16 -o $@ $<
$(addprefix $(OBJ)/,$(addsuffix .o,$(TZ_OBJS))): $(OBJ)/%.o: $(OBJ)/%.tz.s
	$(CC) -c -o $@ $<

KOBJ += $(OBJ)/glue_tz.o

# Drop unused functions: ld ignores --gc-sections when the output format is "binary", so link as ELF and flatten with objcopy.
# Every gcc function / data object gets its own section; tzcc already puts each function in .text.<name>.
EXTSH_DEF += -ffunction-sections -fdata-sections
$(OBJ)/link-kernel-elf.ld: link-kernel.ld | $(OBJ)
	sed 's/OUTPUT_FORMAT(binary)/OUTPUT_FORMAT(elf32-i386)/' $< > $@
$(OBJ)/kernel.bin: $(KOBJ) $(OBJ)/link-kernel-elf.ld
	$(LD) --gc-sections --defsym=KSTK_TOP=$(KSTK_TOP) -T $(OBJ)/link-kernel-elf.ld -o $(OBJ)/kernel.elf $(KOBJ) 2>&1 | grep -v "RWX permissions" || true
	ia16-elf-objcopy -O binary $(OBJ)/kernel.elf $@
	@sz=$$(stat -c%s $@); echo "kernel.bin = $$sz bytes (gc-sections)"

$(OBJ)/kernel.bin: $(OBJ)/glue_tz.o

# ---- the DRIVER and the commands that use it ----
UCFLAGS += -DTZ_DRV
$(OBJ)/drv16e.o: tz/drv16e.S user/drvtab.h user/drvpsp.h | $(OBJ)
	$(CC) -x assembler-with-cpp -Iuser -c -o $@ $<
$(OBJ)/drv16.o: $(OBJ)/drv16.tz.s
	$(CC) -c -o $@ $<
$(OBJ)/drvtty.o: tz/drvtty.S | $(OBJ)
	$(CC) -x assembler-with-cpp -Iuser -c -o $@ $<
$(OBJ)/driver.bin: $(OBJ)/drv16e.o $(OBJ)/drv16.o $(OBJ)/drvtty.o tz/drv16.ld
	$(LD) -T tz/drv16.ld -o $@ $(OBJ)/drv16e.o $(OBJ)/drv16.o $(OBJ)/drvtty.o
	@echo "driver.bin = $$(stat -c%s $@) bytes"
USERBINS += $(OBJ)/driver.bin
$(IMG): $(OBJ)/driver.bin

$(OBJ)/drvc.o: user/drvc.S user/drvtab.h user/drvpsp.h | $(OBJ)
	$(CC) -x assembler-with-cpp -Iuser -c -o $@ $<
# ELF link with --gc-sections (each DRIVER stub has its own section), then flat: only the stubs a command calls stay.
$(OBJ)/cmd-elf.ld: user/cmd.ld | $(OBJ)
	sed -e 's/OUTPUT_FORMAT(binary)/OUTPUT_FORMAT(elf32-i386)/' -e 's/^    \*(\.text\.start)/    KEEP(*(.text.start))/' $< > $@
$(OBJ)/%.bin: $(OBJ)/ucmd_%.o $(UCRT) $(OBJ)/drvc.o $(OBJ)/cmd-elf.ld
	rm -f $(OBJ)/$*.elf; $(LD) --gc-sections -T $(OBJ)/cmd-elf.ld $(if $(filter $*,$(XWANT_CMDS)),--defsym=__xwant=$(XWANT_$*)) -o $(OBJ)/$*.elf $(UCRT) $(OBJ)/drvc.o $< $(if $(filter $*,$(NET_CMDS)),$(NETOBJ) $(OBJ)/nstd16.o $(OBJ)/libgcc.o) 2>&1 | grep -v "RWX permissions" || true
	ia16-elf-objcopy -O binary $(OBJ)/$*.elf $@
